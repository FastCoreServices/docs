{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "FastCore Documentation",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Infraestructuras",
        "pages": [
          "instalacion-bezsel",
          "agregar-sistema"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
